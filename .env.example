# Backend address. Defaults to the live server: https://chronicle-blogs.duckdns.org/buy-together
# Uncomment to use the standalone backend running on your machine instead.
# VITE_API_URL=http://localhost:8080

# OAuth client id from Google Cloud Console (same one as the backend). Leave unset to hide "Continue with Google".
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
